# Browser-side API base (baked into the client bundle).
VITE_API_URL=https://polybot-production-7186.up.railway.app/

# Server-side API base used by SSR / route handlers at runtime. On Railway this
# is the backend's PRIVATE network URL (free, no public hop):
#   API_URL_SERVER=http://polybot.railway.internal:8080
API_URL_SERVER=http://localhost:8000

# Public URL used only during `next build` (the private network is not
# reachable at build time). Leave unset for local builds.
# API_URL_BUILD=https://polybot-production-7186.up.railway.app
